{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../ui",
    "distDir": "../ui",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Apple Notes Lens",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "Apple Notes Lens",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src http://127.0.0.1:* http://localhost:*"
    },
    "bundle": {
      "active": true,
      "identifier": "com.local.notesrag",
      "targets": ["dmg", "app"],
      "icon": []
    }
  }
}
